{
  "name": "statuta-concept-demonstrator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "allowedDeprecatedVersions": {
      "eslint": "9.39.5"
    },
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver"]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src eslint.config.mjs --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test src/components/word-diff.test.ts src/domain/statuta.test.ts src/i18n/content.test.ts"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
